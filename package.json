{
  "name": "agentforge-wait-tickets",
  "version": "0.1.0",
  "description": "AgentForge C4 durable async wait/resume tickets (exactly-once claim)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wait-tickets": "dist/index.js",
    "wait-tickets-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "mcp": "tsx src/mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agentforge",
    "wait-tickets",
    "exactly-once-claim"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "hono": "^4.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
